      "useLocaleFromApp": true,
      "layoutProperties": {
        "primaryColor": "#2c7a4b"
      }
    },
    "docs": {
      "addOnType": "EDITOR"
    },
    "slides": {
      "addOnType": "EDITOR"
    }
  }
